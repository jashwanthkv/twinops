# ============================================================
# TwinOps AIE Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Groq LLM -----
AIE_GROQ_API_KEY=your_groq_api_key_here
AIE_GROQ_MODEL=llama-3.3-70b-versatile

# ----- Application -----
AIE_APP_HOST=0.0.0.0
AIE_APP_PORT=8000
AIE_DEBUG=false

# ----- Workspace -----
# Base directory where repository clones are stored locally
AIE_WORKSPACE_BASE_DIR=./aie_workspaces

# ----- GitHub (optional — for private repo access) -----
AIE_GITHUB_TOKEN=

# ----- Vector Store (ChromaDB) -----
# "memory" keeps everything in-process; set a path to persist to disk
AIE_CHROMA_MODE=memory

# ----- Embedding model -----
AIE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Analysis limits -----
AIE_MAX_FILE_SIZE_BYTES=524288
AIE_MAX_FILES_PER_REPO=5000
AIE_ANALYSIS_TIMEOUT_SECONDS=600
